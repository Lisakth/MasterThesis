Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"roots", " ", "=", " ", 
  RowBox[{"Roots", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"s", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"s", "^", "2"}], "+", 
        RowBox[{"s", " ", 
         RowBox[{"(", 
          RowBox[{"k2", "+", "k3", "+", "k4", "+", "k5"}], ")"}]}], "+", 
        RowBox[{"k2", " ", "k4"}], "+", 
        RowBox[{"k4", " ", "k5"}]}], ")"}]}], "==", "0"}], ",", "s"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.979201493507297*^9, 3.97920152937792*^9}, {
  3.9792015643848343`*^9, 3.9792015675187893`*^9}},
 CellLabel->
  "In[429]:=",ExpressionUUID->"76292384-6086-4735-9677-82be81565122"],

Cell[BoxData[
 RowBox[{
  RowBox[{"s", "\[Equal]", "0"}], "||", 
  RowBox[{"s", "\[Equal]", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "k2"}], "-", "k3", "-", "k4", "-", "k5", "-", 
      SqrtBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"k2", "+", "k3", "+", "k4", "+", "k5"}], ")"}], "2"], "-", 
        RowBox[{"4", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"k2", " ", "k4"}], "+", 
           RowBox[{"k4", " ", "k5"}]}], ")"}]}]}]]}], ")"}]}]}], "||", 
  RowBox[{"s", "\[Equal]", 
   RowBox[{
    FractionBox["1", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "k2"}], "-", "k3", "-", "k4", "-", "k5", "+", 
      SqrtBox[
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"k2", "+", "k3", "+", "k4", "+", "k5"}], ")"}], "2"], "-", 
        RowBox[{"4", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"k2", " ", "k4"}], "+", 
           RowBox[{"k4", " ", "k5"}]}], ")"}]}]}]]}], ")"}]}]}]}]], "Output",
 CellChangeTimes->{3.979201532430929*^9, 3.9792015706777277`*^9, 
