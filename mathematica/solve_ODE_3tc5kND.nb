Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Gamma", "=", 
   RowBox[{"k2", "+", "k3", "+", "k4", "+", "k5"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Delta", "=", 
    RowBox[{
     RowBox[{"Gamma", "^", "2"}], "-", 
     RowBox[{"4", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"k2", " ", "k4"}], "+", 
        RowBox[{"k4", " ", "k5"}]}], ")"}]}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"theta1", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"Gamma", "+", 
      RowBox[{"Sqrt", "[", "Delta", "]"}]}], ")"}], "/", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"theta2", "=", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"Gamma", "-", 
       RowBox[{"Sqrt", "[", "Delta", "]"}]}], ")"}], "/", "2"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Factor", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"s", "+", "theta1"}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{"s", "+", "theta2"}], ")"}]}], "]"}], "\n"}], "Input",
 CellChangeTimes->{
  3.9791812864413357`*^9, {3.979201812223196*^9, 3.979201816733877*^9}},
